{
    "elpro_quantum_diagnostics": {
        "icon_url": "https://cdn.jsdelivr.net/gh/getdoover/app-icons@f6ca20eca2c2d1e05184cb06bf6fee951bba40e7/icons/elpro.png",
        "name": "elpro_quantum_diagnostics",
        "display_name": "ELPRO Quantum Diagnostics",
        "type": "DEV",
        "visibility": "PUB",
        "allow_many": false,
        "description": "Radio, charger/MPPT and power-rail diagnostics for an ELPRO Quantum.",
        "long_description": "README.md",
        "depends_on": [],
        "organisation_id": null,
        "image_name": "registry.doover.com/apps/elpro_quantum_diagnostics:main",
        "build_args": "--platform linux/amd64,linux/arm64",
        "config_schema": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "$id": "",
            "title": "$default",
            "type": "object",
            "properties": {
                "poll_interval_s": {
                    "title": "Poll Interval (s)",
                    "x-name": "poll_interval_s",
                    "x-hidden": false,
                    "type": [
                        "number",
                        "null"
                    ],
                    "x-required": false,
                    "description": "How often to re-read the unit. The radio's counters move slowly and each read costs a transaction on the radio's internal link, so there is little to gain below about 10 seconds.",
                    "default": 30.0,
                    "x-position": 0,
                    "minimum": 5.0
                },
                "read_radio": {
                    "title": "Read Radio",
                    "x-name": "read_radio",
                    "x-hidden": false,
                    "type": [
                        "boolean",
                        "null"
                    ],
                    "x-required": false,
                    "description": "Read the licensed-band radio's diagnostics from sysfs. Requires the app to run on the Quantum itself with host networking, which is how Doover deploys apps by default.",
                    "default": true,
                    "x-position": 1
                },
                "radio_device": {
                    "title": "Radio Device",
                    "x-name": "radio_device",
                    "x-hidden": false,
                    "type": [
                        "string",
                        "null"
                    ],
                    "x-required": false,
                    "description": "Which radio to read, e.g. 'phy1', or a full sysfs path. Leave blank to auto-detect, which is correct unless the unit has more than one radio module fitted.",
                    "default": null,
                    "x-position": 2
                },
                "read_charger__mppt": {
                    "title": "Read Charger / MPPT",
                    "x-name": "read_charger__mppt",
                    "x-hidden": false,
                    "type": [
                        "boolean",
                        "null"
                    ],
                    "x-required": false,
                    "description": "Read the BQ25756 solar charge controller from sysfs.",
                    "default": true,
                    "x-position": 3
                },
                "read_unit_configuration": {
                    "title": "Read Unit Configuration",
                    "x-name": "read_unit_configuration",
                    "x-hidden": false,
                    "type": [
                        "boolean",
                        "null"
                    ],
                    "x-required": false,
                    "description": "Read the MPPT and charger settings, and the unit's identity, from the Quantum's own configuration daemon on localhost. Read-only.",
                    "default": true,
                    "x-position": 4
                },
                "configuration_server": {
                    "title": "Configuration Server",
                    "x-name": "configuration_server",
                    "x-hidden": false,
                    "type": [
                        "string",
                        "null"
                    ],
                    "x-required": false,
                    "description": "Address of the unit's configuration daemon.",
                    "default": "127.0.0.1",
                    "x-position": 5
                },
                "configuration_server_port": {
                    "title": "Configuration Server Port",
                    "x-name": "configuration_server_port",
                    "x-hidden": false,
                    "type": [
                        "integer",
                        "null"
                    ],
                    "x-required": false,
                    "description": "TCP port of the unit's configuration daemon.",
                    "default": 4783,
                    "x-position": 6,
                    "minimum": 1,
                    "maximum": 65535
                },
                "read_supply_and_battery_rails": {
                    "title": "Read Supply and Battery Rails",
                    "x-name": "read_supply_and_battery_rails",
                    "x-hidden": false,
                    "type": [
                        "boolean",
                        "null"
                    ],
                    "x-required": false,
                    "description": "Read the supply and battery voltages and currents over the unit's Modbus TCP server. The server is off on a factory Quantum and has to be enabled in the web config before this will report anything.",
                    "default": true,
                    "x-position": 7
                },
                "modbus_server": {
                    "title": "Modbus Server",
                    "x-name": "modbus_server",
                    "x-hidden": false,
                    "type": [
                        "string",
                        "null"
                    ],
                    "x-required": false,
                    "description": "Address of the Quantum's Modbus TCP server.",
                    "default": "127.0.0.1",
                    "x-position": 8
                },
                "modbus_server_port": {
                    "title": "Modbus Server Port",
                    "x-name": "modbus_server_port",
                    "x-hidden": false,
                    "type": [
                        "integer",
                        "null"
                    ],
                    "x-required": false,
                    "description": "TCP port of the Quantum's Modbus TCP server.",
                    "default": 502,
                    "x-position": 9,
                    "minimum": 1,
                    "maximum": 65535
                },
                "weak_signal_threshold_dbm": {
                    "title": "Weak Signal Threshold (dBm)",
                    "x-name": "weak_signal_threshold_dbm",
                    "x-hidden": false,
                    "type": [
                        "number",
                        "null"
                    ],
                    "x-required": false,
                    "description": "Raise a warning when the last received packet was weaker than this. -100 dBm leaves useful margin on a 12.5 kHz channel; lower it on a link that is known to run close to the noise floor.",
                    "default": -100.0,
                    "x-position": 10
                },
                "dv_app_position": {
                    "title": "Position",
                    "x-name": "dv_app_position",
                    "x-hidden": true,
                    "type": [
                        "integer",
                        "null"
                    ],
                    "x-required": false,
                    "description": "Position of Application in UI Structure. Smaller numbers are closer to the top.",
                    "default": 100,
                    "x-position": 11,
                    "minimum": 0
                }
            },
            "additionalElements": true,
            "required": []
        },
        "ui_schema": {
            "displayString": "$config.app().APP_DISPLAY_NAME",
            "hidden": "$config.app().interpreter_hidden:boolean:false",
            "fullWidth": "$config.app().interpreter_full_width:boolean:false",
            "position": "$config.app().dv_app_position:number:100",
            "icon": null,
            "colour": null,
            "defaultOpen": "$config.app().dv_app_default_open:boolean",
            "type": "uiApplication",
            "name": "$config.app().APP_KEY",
            "children": {
                "signal_last_packet": {
                    "name": "signal_last_packet",
                    "type": "uiVariable",
                    "displayString": "Signal (last packet)",
                    "showActivity": true,
                    "position": 51,
                    "hidden": false,
                    "units": "dBm",
                    "varType": "float",
                    "currentValue": "$tag.app().rssi_last_dbm:number:null",
                    "decPrecision": 0,
                    "ranges": [
                        {
                            "min": -120,
                            "max": -110,
                            "colour": "red",
                            "show_on_graph": true,
                            "label": "Poor"
                        },
                        {
                            "min": -110,
                            "max": -100,
                            "colour": "yellow",
                            "show_on_graph": true,
                            "label": "Fair"
                        },
                        {
                            "min": -100,
                            "max": -40,
                            "colour": "green",
                            "show_on_graph": true,
                            "label": "Good"
                        }
                    ],
                    "live": true
                },
                "signal_margin": {
